\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Microstructure illustration in Model~0. Panel (a) shows the static-fee CEX and DEX prices with the no-arbitrage band. Panel (b) shows that toxicity-based fees widen the no-arbitrage band during stale-quote episodes, reducing executed arbitrage and attenuating the next-block correction of the DEX price toward the CEX price.}}{34}{figure.caption.24}\protected@file@percent }
\newlabel{fig:microstructure_prices}{{1}{34}{Microstructure illustration in Model~0. Panel (a) shows the static-fee CEX and DEX prices with the no-arbitrage band. Panel (b) shows that toxicity-based fees widen the no-arbitrage band during stale-quote episodes, reducing executed arbitrage and attenuating the next-block correction of the DEX price toward the CEX price}{figure.caption.24}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Autocorrelation function of end-of-block DEX log returns in the representative Model~0 seed used in Figure~\ref {fig:microstructure_prices}. Static fees generate a pronounced lag-1 negative spike (\(-0.450\)); toxicity-based fees attenuate the lag-1 autocorrelation to \(-0.049\), consistent with fewer next-block arbitrage corrections.}}{35}{figure.caption.25}\protected@file@percent }
\newlabel{fig:microstructure_acf}{{2}{35}{Autocorrelation function of end-of-block DEX log returns in the representative Model~0 seed used in Figure~\ref {fig:microstructure_prices}. Static fees generate a pronounced lag-1 negative spike (\(-0.450\)); toxicity-based fees attenuate the lag-1 autocorrelation to \(-0.049\), consistent with fewer next-block arbitrage corrections}{figure.caption.25}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Final hedged PnL (token-1) across models and fee modes. Cells report mean \(\pm \) standard error across 100 seeds. Inactive cohorts (e.g., JIT in Models 0--1) are left blank.}}{35}{figure.caption.27}\protected@file@percent }
\newlabel{fig:pnl_heatmap}{{3}{35}{Final hedged PnL (token-1) across models and fee modes. Cells report mean \(\pm \) standard error across 100 seeds. Inactive cohorts (e.g., JIT in Models 0--1) are left blank}{figure.caption.27}{}}
\@writefile{lot}{\contentsline {table}{\numberline {2}{\ignorespaces Routing and fee outcomes across model specifications and fee schedules. The reported diagnostics are the smart-router DEX share, cumulative fee value, and time-averaged taker fee. Entries are means \(\pm \) standard errors across 100 independent seeds. DEX share is measured as the percentage of smart-router trades routed to the AMM; passive, active, and total fee values are cumulative token-1 fee revenues for the displayed standing LP cohorts, with total equal to passive plus active fees; average taker fees are reported in basis points. Static rows use the fixed baseline fee \(f_0=1\) bp.}}{36}{table.caption.30}\protected@file@percent }
\newlabel{tab:routing_fee_summary}{{2}{36}{Routing and fee outcomes across model specifications and fee schedules. The reported diagnostics are the smart-router DEX share, cumulative fee value, and time-averaged taker fee. Entries are means \(\pm \) standard errors across 100 independent seeds. DEX share is measured as the percentage of smart-router trades routed to the AMM; passive, active, and total fee values are cumulative token-1 fee revenues for the displayed standing LP cohorts, with total equal to passive plus active fees; average taker fees are reported in basis points. Static rows use the fixed baseline fee \(f_0=1\) bp}{table.caption.30}{}}
\@writefile{lot}{\contentsline {table}{\numberline {3}{\ignorespaces Arbitrage-related metrics reported as (mean, standard deviation) across simulation runs for the baseline parameterization in Table~\ref {tab:common_params}. “Arb Exec” denotes the number of executed arbitrage trades, “No Arb” the number of instances in which arbitrage was infeasible because prices lay within the no-arbitrage band, and “Arb Rej” the number of arbitrage attempts rejected by the profitability filter.}}{36}{table.caption.31}\protected@file@percent }
\newlabel{tab:arb_detailed}{{3}{36}{Arbitrage-related metrics reported as (mean, standard deviation) across simulation runs for the baseline parameterization in Table~\ref {tab:common_params}. “Arb Exec” denotes the number of executed arbitrage trades, “No Arb” the number of instances in which arbitrage was infeasible because prices lay within the no-arbitrage band, and “Arb Rej” the number of arbitrage attempts rejected by the profitability filter}{table.caption.31}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Median of $R_t=\Delta \mathrm  {LVR}_t/\Delta F_t$ vs block time $B$ for the static benchmark and the toxicity-driven fee schedule in Model~2 (50 runs). The Jiter curve is computed conditional on successful JIT executions.}}{37}{figure.caption.32}\protected@file@percent }
\newlabel{fig:model2_blocksize_ratio}{{4}{37}{Median of $R_t=\Delta \mathrm {LVR}_t/\Delta F_t$ vs block time $B$ for the static benchmark and the toxicity-driven fee schedule in Model~2 (50 runs). The Jiter curve is computed conditional on successful JIT executions}{figure.caption.32}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Median of $R_t=\Delta \mathrm  {LVR}_t/\Delta F_t$ vs block time $B$ for the two volatility-driven fee schedules in Model~2 (50 runs). The Jiter curve is computed conditional on successful JIT executions.}}{38}{figure.caption.33}\protected@file@percent }
\newlabel{fig:model2_blocksize_ratio_vol}{{5}{38}{Median of $R_t=\Delta \mathrm {LVR}_t/\Delta F_t$ vs block time $B$ for the two volatility-driven fee schedules in Model~2 (50 runs). The Jiter curve is computed conditional on successful JIT executions}{figure.caption.33}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces Median per-block $\Delta \mathrm  {LVR}$ vs block time $B$ for active LPs, passive LPs, and the Jiter in Model~2 (50 runs), shown only for the static benchmark and the toxicity-driven fee schedule. These panels make visible the distinction emphasized in the text: static fees combine worse fee coverage with lower or non-monotone $\Delta \mathrm  {LVR}$ dynamics for some cohorts, whereas toxicity improves fee coverage while allowing per-block stale-quote losses to rise more steadily with block length.}}{39}{figure.caption.34}\protected@file@percent }
\newlabel{fig:delta_lvr_vsd_blocksize}{{6}{39}{Median per-block $\Delta \mathrm {LVR}$ vs block time $B$ for active LPs, passive LPs, and the Jiter in Model~2 (50 runs), shown only for the static benchmark and the toxicity-driven fee schedule. These panels make visible the distinction emphasized in the text: static fees combine worse fee coverage with lower or non-monotone $\Delta \mathrm {LVR}$ dynamics for some cohorts, whereas toxicity improves fee coverage while allowing per-block stale-quote losses to rise more steadily with block length}{figure.caption.34}{}}
